.vscode/**
.vscode-test/**
.claude/**
src/**
node_modules/**
# tsc emits one .js per source file into out/ as a side effect of type
# checking; only the two esbuild bundles (out/extension.js, out/webview/*)
# are ever loaded at runtime.
out/core/**
out/test/**
# The real-VS-Code integration suite's compiled output (a separate
# tsconfig/outDir from the runtime bundle — see tsconfig.integration.json)
# and every project tsconfig — none of these are ever loaded at runtime,
# only out/extension.js and out/webview/* are.
out-integration/**
tsconfig*.json
vitest.config.ts
playwright.config.ts
playwright-report/**
test-results/**
.gitignore
.vscodeignore
docs/**
package-lock.json
# Manual-testing fixture referenced from the README's Development section
# only — not needed at runtime.
samples/**
**/*.vsix
