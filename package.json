{
  "name": "csv-viewer",
  "displayName": "CSV Viewer: Table + Row Details",
  "description": "Read wide CSV/TSV files without scrolling sideways: keep key columns in the table, expand any row to read long text and JSON. Filter, sort, live reload.",
  "version": "0.6.1",
  "publisher": "markdown-collab",
  "license": "MIT",
  "icon": "media/icon.png",
  "pricing": "Free",
  "qna": false,
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ronicayu/csv-viewer.git"
  },
  "homepage": "https://github.com/ronicayu/csv-viewer#readme",
  "bugs": {
    "url": "https://github.com/ronicayu/csv-viewer/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "csv",
    "tsv",
    "tab",
    "table",
    "viewer",
    "preview",
    "grid",
    "columns",
    "filter",
    "sort",
    "json",
    "wide",
    "data"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "csvViewer.open",
        "category": "CSV Viewer",
        "title": "Open in CSV Viewer",
        "icon": "$(table)"
      },
      {
        "command": "csvViewer.openAsText",
        "category": "CSV Viewer",
        "title": "Open as Text",
        "icon": "$(go-to-file)"
      }
    ],
    "customEditors": [
      {
        "viewType": "csvViewer.table",
        "displayName": "CSV Viewer",
        "selector": [
          {
            "filenamePattern": "*.[cC][sS][vV]"
          },
          {
            "filenamePattern": "*.[tT][sS][vV]"
          },
          {
            "filenamePattern": "*.[tT][aA][bB]"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "csvViewer.open",
          "when": "resourceExtname =~ /^\\.(csv|tsv|tab)$/i",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "csvViewer.open",
          "when": "resourceExtname =~ /^\\.(csv|tsv|tab)$/i && activeCustomEditorId != csvViewer.table",
          "group": "navigation"
        },
        {
          "command": "csvViewer.openAsText",
          "when": "activeCustomEditorId == csvViewer.table",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "csvViewer.open",
          "when": "resourceExtname =~ /^\\.(csv|tsv|tab)$/i"
        },
        {
          "command": "csvViewer.openAsText",
          "when": "activeCustomEditorId == csvViewer.table"
        }
      ]
    },
    "configuration": {
      "title": "CSV Viewer",
      "properties": {
        "csvViewer.defaultTableColumns": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "description": "The most columns shown in the table when a file is first opened. Short columns are chosen in file order; long-text, multi-line and JSON columns start in the row details regardless."
        },
        "csvViewer.suggestOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "When a CSV, TSV, or TAB file is opened as plain text for the first time, ask whether to view it as a table instead. Turn this off to stop being asked."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && npm run bundle:extension && npm run bundle:webview && npm run bundle:worker && npm run copy:codicons",
    "watch": "tsc -w -p .",
    "bundle:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js --sourcemap",
    "bundle:webview": "esbuild src/webview/main.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=out/webview/main.js --sourcemap && node -e \"require('fs').copyFileSync('src/webview/main.css','out/webview/main.css')\"",
    "bundle:worker": "esbuild src/webview/worker.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=out/webview/worker.js --sourcemap",
    "copy:codicons": "node -e \"require('fs').copyFileSync('node_modules/@vscode/codicons/dist/codicon.css','out/webview/codicon.css'); require('fs').copyFileSync('node_modules/@vscode/codicons/dist/codicon.ttf','out/webview/codicon.ttf')\"",
    "typecheck:webview": "tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webview": "npm run compile && tsc -p tsconfig.e2e.json --noEmit && playwright test",
    "test:perf": "npm run compile && PERF_TESTS=1 playwright test src/test/webview-e2e/stress/scale.spec.ts --workers=1 && PERF_TESTS=1 vitest run src/test/stress",
    "compile:integration": "node -e \"require('fs').rmSync('out-integration',{recursive:true,force:true})\" && tsc -p tsconfig.integration.json",
    "test:integration": "npm run compile && npm run compile:integration && node ./out-integration/test/integration/runTest.js",
    "package": "vsce package --no-dependencies",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.5.2",
    "@types/vscode": "^1.80.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "fast-check": "^4.10.2",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.9.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "papaparse": "^5.7.0"
  }
}
