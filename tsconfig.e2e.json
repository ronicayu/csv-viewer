{
  "//": "Specs mix Node APIs (Playwright, fs) with DOM APIs (page.evaluate bodies); no other tsconfig includes them.",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/test/webview-e2e/**/*.ts", "playwright.config.ts"]
}
